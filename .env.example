NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Sanity CMS connection.
# The site uses safe demo fallback content until these are configured.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional production enquiry delivery.
# When unset, forms validate and return a clearly labelled demo-mode success state.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
