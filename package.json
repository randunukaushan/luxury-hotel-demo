{
  "name": "luxury-hotel-demo",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "validate:production": "node scripts/validate-production.mjs",
    "quality": "npm run lint && npm run typecheck && npm run build",
    "studio": "sanity dev",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:check": "npm run security:scan && npm run audit:prod"
  },
  "dependencies": {
    "@sanity/client": "8.6.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.3.5",
    "typescript": "^5.9.0",
    "sanity": "6.15.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8"
}
